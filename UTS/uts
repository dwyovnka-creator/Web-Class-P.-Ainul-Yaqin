.result-card {
      background: white;
      border: 1.5px solid #d4b87a;
      border-radius: 15px;
      padding: 24px 28px;
      display: none;
    }

    .result-card h2 {
      font-size: 18px;
      color: #9a6200;
      margin-bottom: 16px;
      padding-bottom: 10px;
      border-bottom: 1.5px solid #ecd9a8;
    }

    .result-table { 
      width: 100%; 
    }

    .result-table tr {
      border-bottom: 1px solid #ecdcb0;
    }

     .result-table tr:last-child {
      border-bottom: none;
    }

    .result-table td:first-child {
      width: 160px;
      font-weight: bold;
      color: #7a6040;
      padding: 8px 10px 8px 0;
    }

    .result-table td:last-child {
      color: #3d2b0e;
      padding: 8px 0;
    }
